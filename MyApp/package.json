{
  "name": "myapp",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.25",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "allure": "3.33.0",
    "allure-jest": "3.15.0",
    "allure-js-commons": "3.15.0",
    "diff-cover": "2.0.5",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC LC_ALL=en_US.UTF-8 jest",
    "test:watch": "npm test -- --watch",
    "test:changed": "npm test -- --onlyChanged",
    "test:ios": "npm test -- --selectProjects ios",
    "test:android": "npm test -- --selectProjects android",
    "test:all-platforms": "JEST_ALL_PLATFORMS=true npm test --",
    "test:integration": "npm test -- --testPathPatterns='\\.integration\\.test\\.'",
    "test:random": "npm run test:all-platforms -- --randomize",
    "test:coverage": "npm test -- --coverage",
    "test:coverage:diff": "sh scripts/check-diff-coverage.sh",
    "test:report": "rm -rf allure-results allure-report && allure run -- npm run test:coverage",
    "test:report:generate": "allure generate",
    "test:report:open": "allure open allure-report",
    "test:report:view": "node scripts/test-report-view.mjs"
  },
  "overrides": {
    "diff-cover": {
      "typescript": "$typescript"
    }
  },
  "private": true
}
